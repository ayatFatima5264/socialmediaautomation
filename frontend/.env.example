# Frontend environment (Vite). Copy to .env.local and fill in as needed.
# Only VITE_-prefixed vars are exposed to the browser bundle.

# Backend API origin. Leave BLANK in local dev — the Vite dev server proxies
# /api and /auth to http://localhost:8000. In production set it to your backend's
# public URL (no trailing slash), e.g. https://api.yourdomain.com
VITE_API_URL=

# Canonical public origin — used for canonical URLs, Open Graph, sitemap.xml,
# robots.txt, and the build-time prerendered meta tags. MUST match the domain
# the site is actually served from, with no trailing slash. If this is wrong,
# every canonical tag points search engines at a different site.
# On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL when unset.
VITE_SITE_URL=https://autosocial.zaions.com

# --- Analytics & ads (optional; nothing loads unless an ID is set, and
#     nothing loads at all until the visitor accepts the cookie banner) ------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_ID=
# Microsoft Clarity project ID
VITE_CLARITY_ID=
# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
# Setting this also generates /ads.txt at build time, which AdSense requires.
VITE_ADSENSE_ID=

# --- Marketing contact form -----------------------------------------------
# Set to "true" once the backend POST /api/contact endpoint is implemented.
# Until then the form acknowledges submissions locally.
VITE_CONTACT_API=false
