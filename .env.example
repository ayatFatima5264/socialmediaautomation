# ---- AI provider --------------------------------------------------------
# Primary provider. Real free options: "groq" (Llama) or "gemini" (Google).
# "mock" = offline. If the primary fails at request time it falls back to the
# providers below (JSON list; any without a key are skipped; [] disables it).
AI_PROVIDER=groq
AI_FALLBACK_PROVIDERS=["gemini"]

# Google Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq — free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Generation knobs ---------------------------------------------------
AI_REQUEST_TIMEOUT=30
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.8

# ---- Database -----------------------------------------------------------
# Production: PostgreSQL. Local fallback: sqlite:///./social_saas.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/social_saas

# ---- Auth ---------------------------------------------------------------
# Generate a strong secret, e.g.  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Video Studio: object storage (Cloudflare R2) -----------------------
# Where Video Studio keeps the bytes it produces: uploads, voice-overs,
# rendered videos, thumbnails. NEVER the database and never the container
# disk — Render wipes the disk on every deploy, and a rendered MP4 is two
# orders of magnitude larger than the images `media_assets` was sized for.
#
#   auto      R2 when the four values below are set, else the database
#   r2        Cloudflare R2; a missing credential is a hard error
#   database  bytes in Postgres. DEVELOPMENT ONLY.
#
# Leave this on `auto` locally: a fresh clone then works with no bucket.
# Production MUST set STORAGE_BACKEND=r2 (see .env.production.example) so a
# missing credential fails loudly instead of silently filling the database.
STORAGE_BACKEND=auto

# From the Cloudflare dashboard: R2 -> Manage API tokens -> Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only needed for a custom endpoint (an S3-compatible stand-in such as MinIO).
# Otherwise it is derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
# Set when the bucket is served on a public domain (r2.dev or your own).
# Unset means the bucket stays private and reads are presigned.
R2_PUBLIC_BASE_URL=
# Lifetime of a presigned GET, in seconds. Only used for a private bucket.
STORAGE_SIGNED_URL_TTL=3600

# ---- Video Studio: compute limits ---------------------------------------
# Rendering currently runs inside the API process. These caps are what keep
# one long render from starving every other request; raise them when
# rendering moves to a dedicated worker.
VIDEO_MAX_DURATION_SECONDS=180
VIDEO_MAX_RESOLUTION_HEIGHT=1080
VIDEO_MAX_UPLOAD_MB=200
VIDEO_MAX_CONCURRENT_RENDERS=1

# ---- Video Studio: voice + subtitles ------------------------------------
# "edge" is free, needs no key, and is the only option here that speaks Urdu.
# "groq" reuses GROQ_API_KEY (English and Arabic only).
TTS_PROVIDER=edge
# Transcription runs Whisper on Groq, using the same GROQ_API_KEY.
TRANSCRIPTION_PROVIDER=groq

# ---- Video Studio: custom / self-hosted TTS -----------------------------
# Any server exposing OpenAI's POST /audio/speech, which is what the
# self-hostable open-source engines already speak - openedai-speech (Piper,
# Coqui XTTS), Kokoro-FastAPI, LocalAI. Setting these runs Voice Studio with
# no external voice service at all.
#
# There is no voice-catalogue route in that API, so the voices are named here
# as "id:gender:locale", comma-separated. Gender and locale are optional.
#   TTS_PROVIDER=custom
#   CUSTOM_TTS_BASE_URL=http://localhost:8080/v1
#   CUSTOM_TTS_VOICES=alloy:female:en-US,piper_asad:male:ur-PK
CUSTOM_TTS_BASE_URL=
CUSTOM_TTS_API_KEY=
CUSTOM_TTS_MODEL=tts-1
CUSTOM_TTS_VOICES=
# wav | mp3 | opus | aac | flac
CUSTOM_TTS_FORMAT=wav

# ---- OAuth token encryption at rest -------------------------------------
# Encrypts the access/refresh tokens stored for connected social accounts.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated for rotation: the first key encrypts, all are tried to decrypt.
# Leave blank to store tokens in plaintext (not recommended outside local dev).
TOKEN_ENCRYPTION_KEY=

# ---- Meta OAuth (Facebook + Instagram) ----------------------------------
# A single Meta app powers both Facebook Login and Instagram (Instagram Business
# via Facebook Login). See "Meta OAuth Setup" in docs/OAUTH_CALLBACKS.md.
# Do NOT put real secrets in this example file — set them only in .env.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback
# Instagram uses the same Meta app; only its redirect URI is separate.
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback

FRONTEND_URL=http://localhost:5173

# ---- Social Accounts: OAuth 2.0 (other platforms) -----------------------
# Public base URL of THIS backend. Callback URLs derive from it as
#   {BACKEND_URL}/api/auth/{platform}/callback
# Register those exact URLs in each developer portal — full list + scopes in
# docs/OAUTH_CALLBACKS.md. A platform without credentials returns a clear error
# on Connect (there is no simulated/mock connect).
BACKEND_URL=http://localhost:8000

# One client id/secret pair per platform (create an app in each portal and
# register the matching callback URL above). Facebook & Instagram use the Meta
# credentials above instead.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Optional. Pinterest matches the redirect URI byte-for-byte against the one
# registered in the Pinterest developer dashboard. Leave blank to use
# {BACKEND_URL}/api/auth/pinterest/callback.
PINTEREST_REDIRECT_URI=
# A Trial-tier Pinterest app can ONLY create Pins in Pinterest's Sandbox
# environment — creating one in production comes back as 403. Leave this
# true until the app is granted Standard access, then set it to false and
# reconnect Pinterest (tokens are not portable between the two).
PINTEREST_SANDBOX=true
# Threads (Meta). The dashboard calls these the App ID / App secret;
# THREADS_APP_ID / THREADS_APP_SECRET are accepted as aliases.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Optional. Meta matches the redirect URI exactly; leave blank to use
# {BACKEND_URL}/api/auth/threads/callback.
THREADS_REDIRECT_URI=

# ---- Outbound email (password reset + contact form) -------------------------
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Resend, SES).
# Port 465 = implicit SSL; anything else (587) uses STARTTLS.
# Unset is safe: reset links are logged, and contact-form messages are still
# stored in the contact_messages table — they are just not emailed to anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Where contact-form messages are forwarded. Falls back to SMTP_FROM / SMTP_USER.
CONTACT_TO_EMAIL=
