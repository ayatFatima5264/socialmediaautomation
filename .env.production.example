# ===========================================================================
# AutoSocial AI — PRODUCTION environment template.
# Copy the values into your host's dashboard (Render/Railway "Environment" tab)
# or into a private .env.production file. NEVER commit real values — this file
# ships placeholders only. Generate secrets, don't reuse the dev ones.
# ===========================================================================

# ---- AI provider ----------------------------------------------------------
# Primary = "groq" (Llama); falls back to Gemini if Groq errors/rate-limits.
# Set the matching API key(s) below. AI_FALLBACK_PROVIDERS is a JSON list; any
# provider without a key is skipped, and [] disables fallback entirely.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDERS=["gemini"]
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Generation knobs (safe defaults)
AI_REQUEST_TIMEOUT=30
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.8

# ---- Database (managed PostgreSQL) ----------------------------------------
# On Render this is injected automatically from the managed DB (see render.yaml).
# If setting manually, either scheme works — the app normalizes it to psycopg v3:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://user:password@host:5432/autosocial

# ---- Auth / JWT -----------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-strong-random-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Video Studio: object storage (Cloudflare R2) -----------------------
# Where Video Studio keeps the bytes it produces: uploads, voice-overs,
# rendered videos, thumbnails. NEVER the database and never the container
# disk — Render wipes the disk on every deploy, and a rendered MP4 is two
# orders of magnitude larger than the images `media_assets` was sized for.
#
#   auto      R2 when the four values below are set, else the database
#   r2        Cloudflare R2; a missing credential is a hard error
#   database  bytes in Postgres. DEVELOPMENT ONLY.
#
# `r2` here is deliberate, not `auto`. With `auto` and a missing credential
# the app falls back to storing video IN POSTGRES and says so only in a log
# line — by the time anyone notices, the database holds gigabytes of MP4.
STORAGE_BACKEND=r2

# From the Cloudflare dashboard: R2 -> Manage API tokens -> Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only needed for a custom endpoint (an S3-compatible stand-in such as MinIO).
# Otherwise it is derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
# Set when the bucket is served on a public domain (r2.dev or your own).
# Unset means the bucket stays private and reads are presigned.
R2_PUBLIC_BASE_URL=
# Lifetime of a presigned GET, in seconds. Only used for a private bucket.
STORAGE_SIGNED_URL_TTL=3600

# ---- Video Studio: compute limits ---------------------------------------
# Rendering currently runs inside the API process. These caps are what keep
# one long render from starving every other request; raise them when
# rendering moves to a dedicated worker.
VIDEO_MAX_DURATION_SECONDS=180
VIDEO_MAX_RESOLUTION_HEIGHT=1080
VIDEO_MAX_UPLOAD_MB=200
VIDEO_MAX_CONCURRENT_RENDERS=1

# ---- Video Studio: voice + subtitles ------------------------------------
# "edge" is free, needs no key, and is the only option here that speaks Urdu.
# "groq" reuses GROQ_API_KEY (English and Arabic only).
TTS_PROVIDER=edge
# Transcription runs Whisper on Groq, using the same GROQ_API_KEY.
TRANSCRIPTION_PROVIDER=groq

# ---- Video Studio: custom / self-hosted TTS -----------------------------
# Any server exposing OpenAI's POST /audio/speech, which is what the
# self-hostable open-source engines already speak - openedai-speech (Piper,
# Coqui XTTS), Kokoro-FastAPI, LocalAI. Setting these runs Voice Studio with
# no external voice service at all.
#
# There is no voice-catalogue route in that API, so the voices are named here
# as "id:gender:locale", comma-separated. Gender and locale are optional.
#   TTS_PROVIDER=custom
#   CUSTOM_TTS_BASE_URL=http://localhost:8080/v1
#   CUSTOM_TTS_VOICES=alloy:female:en-US,piper_asad:male:ur-PK
CUSTOM_TTS_BASE_URL=
CUSTOM_TTS_API_KEY=
CUSTOM_TTS_MODEL=tts-1
CUSTOM_TTS_VOICES=
# wav | mp3 | opus | aac | flac
CUSTOM_TTS_FORMAT=wav

# ---- OAuth token encryption at rest ---------------------------------------
# Encrypts the access/refresh tokens stored for every connected social account.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated for rotation: the first key encrypts, all are tried to decrypt.
# LOSING THIS KEY means every connected account must be reconnected.
TOKEN_ENCRYPTION_KEY=generate-a-fernet-key

# ---- Public URLs (use your real HTTPS domains) ----------------------------
# Public origin of THIS backend. OAuth callbacks derive from it.
BACKEND_URL=https://api.yourdomain.com
# Where OAuth flows send the browser back to (your frontend).
FRONTEND_URL=https://app.yourdomain.com
# Allowed browser origins for CORS — a JSON list (pydantic parses it as JSON).
CORS_ORIGINS=["https://app.yourdomain.com"]

# ---- Scheduler ------------------------------------------------------------
SCHEDULER_POLL_SECONDS=30

# ---- Meta OAuth (Facebook + Instagram share one Meta app) -----------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_GRAPH_VERSION=v21.0
# Must EXACTLY match the redirect URIs registered in the Meta developer portal.
META_REDIRECT_URI=https://api.yourdomain.com/api/auth/facebook/callback
INSTAGRAM_REDIRECT_URI=https://api.yourdomain.com/api/auth/instagram/callback

# ---- Other social platform OAuth (fill in per platform you enable) --------
# Register {BACKEND_URL}/api/auth/{platform}/callback in each portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Optional override; must match the Pinterest dashboard exactly, e.g.
# https://api.yourdomain.com/api/auth/pinterest/callback
PINTEREST_REDIRECT_URI=
# true while the Pinterest app has Trial access (Pins can only be created
# in Sandbox); false once Standard access is granted — then reconnect.
PINTEREST_SANDBOX=true
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# Optional override; must match the Meta dashboard exactly, e.g.
# https://api.yourdomain.com/api/auth/threads/callback
THREADS_REDIRECT_URI=

# ---- AI image generation (Pollinations — free, no key) --------------------
POLLINATIONS_BASE=https://image.pollinations.ai
IMAGE_MODEL=flux
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080

# ---- Outbound email (password reset + contact form) ------------------------
# Gmail needs an APP PASSWORD (Google Account -> Security -> 2-Step
# Verification -> App passwords), not the account password. Set these in the
# Render dashboard; SMTP_PASSWORD is the only secret among them.
# Unset is safe: reset links go to the logs and contact-form messages are still
# stored in the contact_messages table — they are just not emailed to anyone.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=autosocialai5264@gmail.com
SMTP_PASSWORD=
# Gmail rewrites From to the authenticated account — keep it the same address.
SMTP_FROM=AutoSocial AI <autosocialai5264@gmail.com>

# Where contact-form messages are forwarded.
CONTACT_TO_EMAIL=autosocialai5264@gmail.com
